<button id="theme-toggle-button" class="reading-theme-button" type="button" aria-label="Switch light/dark theme" aria-pressed="false" title="切换深色或浅色模式">
  <svg class="reading-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.2 14.2A8.5 8.5 0 0 1 9.8 3.8a8.5 8.5 0 1 0 10.4 10.4Z" /></svg>
  <svg class="reading-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4M17.6 17.6 19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
</button>
<script>
function syncReadingTheme() {
  const dark = document.documentElement.classList.contains('dark')
  document.querySelector('#theme-toggle-button')?.setAttribute('aria-pressed', String(dark))
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#181818' : '#ffffff')
}
document.addEventListener('click', (event) => {
  if (!(event.target instanceof Element) || !event.target.closest('#theme-toggle-button')) return
  const dark = !document.documentElement.classList.contains('dark')
  document.documentElement.classList.toggle('dark', dark)
  try { localStorage.setItem('theme', dark ? 'dark' : 'light') } catch {}
  syncReadingTheme()
  document.dispatchEvent(new Event('theme-changed'))
})
document.addEventListener('astro:page-load', syncReadingTheme)
syncReadingTheme()
</script>

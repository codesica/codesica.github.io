---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import { getPostPath } from '@/i18n/path'
import { getPostDescription } from '@/utils/description'
import { isHomePage } from '@/utils/page'
export interface Props { posts: Post[]; lang: Language; pinned?: boolean }
const { posts, lang, pinned = false } = Astro.props
const isHome = isHomePage(Astro.url.pathname)
---
<ul class="reading-post-list">
  {posts.map(post => {
    const slug = post.data.abbrlink || post.id
    const date = post.data.published.toISOString().slice(0, 10)
    return <li class="reading-post-item">
      <div class="reading-post-heading">
        <h3><a href={getPostPath(slug, lang)}>{post.data.title}</a></h3>
        <time datetime={date}>{date}</time>
      </div>
      {pinned && <span class="reading-pin">置顶</span>}
      {isHome && <p class="reading-excerpt">{getPostDescription(post, 'list')}</p>}
    </li>
  })}
</ul>

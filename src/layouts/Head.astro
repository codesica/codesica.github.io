---
import { ClientRouter } from 'astro:transitions'
import katexCSS from 'katex/dist/katex.min.css?url'
import { base, themeConfig } from '@/config'

interface Props {
  postTitle?: string
  postDescription?: string
  postSlug?: string
}

const { postTitle, postDescription, postSlug } = Astro.props
const { title, subtitle, description, author, favicon, url } = themeConfig.site
const { mode: defaultMode, light: { background: lightMode }, dark: { background: darkMode } } = themeConfig.color
const { katex: katexEnabled, reduceMotion } = themeConfig.global
const isNotFound = /\/404(?:\.html|\/)?$/.test(Astro.url.pathname)
const canonical = new URL(isNotFound ? `${base}/404.html` : Astro.url.pathname, url)
const pageTitle = isNotFound ? `页面未找到 | ${title}` : postTitle ? `${postTitle} | ${title}` : `${title} · ${subtitle}`
const pageDescription = postDescription || description
// Generate article images locally. Never use the upstream author's screenshot API or credentials.
const pageImage = postSlug ? new URL(`${base}/og/${postSlug}.png`, url) : undefined
const metaTheme = defaultMode === 'dark' ? darkMode : lightMode
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href={`${base}${favicon}`} />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="author" content={author} />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content={metaTheme} />
  {isNotFound && <meta name="robots" content="noindex, follow" />}
  <link rel="preload" href={`${base}/fonts/EarlySummer-VF-Split/EarlySummer-VF-Subset.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/Snell-Black-SF.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/Snell-Bold-SF.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/STIX-VF.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/STIX-Italic-VF.woff2`} as="font" type="font/woff2" crossorigin />
  {katexEnabled && <link rel="stylesheet" href={katexCSS} />}
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  <link rel="alternate" href={`${base}/rss.xml`} type="application/rss+xml" title="Kai · RSS" />
  <link rel="alternate" href={`${base}/atom.xml`} type="application/atom+xml" title="Kai · Atom" />
  <meta property="og:type" content={postTitle ? 'article' : 'website'} />
  <meta property="og:site_name" content={title} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  {pageImage && <meta property="og:image" content={pageImage} />}
  <meta name="twitter:card" content={pageImage ? 'summary_large_image' : 'summary'} />
  <ClientRouter fallback="none" />
  <script is:inline define:vars={{ defaultMode, lightMode, darkMode, reduceMotion }}>
    (() => {
      function isDark() {
        let saved = null
        try { saved = localStorage.getItem('theme') } catch { /* Storage can be disabled. */ }
        if (saved === 'dark' || saved === 'light') return saved === 'dark'
        return defaultMode === 'auto' ? matchMedia('(prefers-color-scheme: dark)').matches : defaultMode === 'dark'
      }
      function initialize(doc = document) {
        const dark = isDark()
        doc.documentElement.classList.toggle('dark', dark)
        doc.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? darkMode : lightMode)
        const reduced = reduceMotion || matchMedia('(prefers-reduced-motion: reduce)').matches || !('startViewTransition' in doc)
        doc.documentElement.classList.toggle('reduce-motion', reduced)
      }
      document.addEventListener('astro:before-swap', event => initialize(event.newDocument))
      initialize()
    })()
  </script>
</head>

---
import Layout from '@/layouts/Layout.astro'
import { base } from '@/config'
---

<Layout postTitle="页面未找到">
  <div class="uno-decorative-line" />
  <h1 class="mt--1.3 text-8 c-primary font-bold leading-1.4em lg:text-9">这一页不在这里。</h1>
  <p class="mt-4 text-4 leading-1.8em">地址可能有误，或者页面已经移动。</p>
  <p class="mt-6 text-4"><a href={`${base}/`} class="underline underline-offset-4">← 返回文章列表</a></p>
</Layout>
